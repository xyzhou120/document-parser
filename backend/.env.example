# 生产环境配置示例
# 复制此文件为 .env，并填入实际配置

# ==================== 数据库配置 ====================
DATABASE_HOST=your-postgres-host
DATABASE_PORT=5432
DATABASE_NAME=document_parser
DATABASE_USER=your-db-user
DATABASE_PASSWORD=your-db-password

# ==================== Redis配置 ====================
REDIS_HOST=your-redis-host
REDIS_PORT=6379

# ==================== MinIO配置 ====================
MINIO_ENDPOINT=your-minio-host:9000
MINIO_ACCESS_KEY=your-access-key
MINIO_SECRET_KEY=your-secret-key
MINIO_BUCKET=documents
MINIO_SECURE=true

# ==================== 模型服务配置 ====================
# PaddleOCR
OCR_BASE_URL=http://your-ocr-server:port
OCR_API_KEY=your-ocr-api-key
# Remote OCR deployments must bump this revision after any model change.
# unknown is allowed for development, but cannot detect an in-place remote upgrade.
OCR_MODEL_VERSION=unknown

# 文本LLM（qwen3.7-27b）
TEXT_LLM_BASE_URL=http://your-llm-server:port/v1
TEXT_LLM_API_KEY=your-llm-api-key
TEXT_LLM_MODEL_NAME=qwen3.7-27b
TEXT_LLM_MODEL_VERSION=unknown

# 视觉LLM（qwen3.6-27b，可选）
VISION_LLM_BASE_URL=http://your-vision-llm-server:port/v1
VISION_LLM_API_KEY=your-vision-llm-api-key
VISION_LLM_MODEL_NAME=qwen3.6-27b
VISION_LLM_MODEL_VERSION=unknown

# 清单工具型智能体：每个任务共享预算，版本请填服务部署版本
AGENT_MAX_ROUNDS=12
AGENT_MAX_VIEW_PAGES=20
AGENT_MAX_REGION_VIEWS=24
AGENT_FIELD_BATCH_SIZE=1
AGENT_MAX_TOKENS=3000
AGENT_MAX_CONTEXT_CHARS=24000
AGENT_MAX_TOTAL_TOKENS=60000
AGENT_RENDER_DPI=180

# 可选：隔离新版本试点 Worker；API 和 Worker 必须使用相同队列
CELERY_TASK_DEFAULT_QUEUE=celery
